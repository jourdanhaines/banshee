# banshee claude-code plugin — user-editable options, sourced as sh.
# Edit and run `banshee reload` to apply.

# true: the notification stays on screen until you dismiss or click it.
# false: it expires after TIMEOUT_SECONDS.
REQUIRE_INPUT=true

# Seconds to show the notification when REQUIRE_INPUT=false.
TIMEOUT_SECONDS=10

# Space-separated Claude Code hook events to notify on. "PermissionRequest"
# fires the moment a permission prompt appears (tool approval, plan approval);
# "Notification" carries typed notifications, filtered by NOTIFY_TYPES below.
# "Stop" is deliberately excluded: it fires on every turn end, including while
# background subagents are still running — add it back for a bubble on every
# turn at the cost of that noise.
EVENTS="Notification PermissionRequest"

# Space-separated notification_type allowlist for "Notification" events.
# Known types: agent_needs_input (Claude asks you a question),
# agent_completed (task finished, results ready for review),
# permission_prompt (excluded by default — PermissionRequest already
# notifies immediately), idle_prompt (excluded — fires while Claude is
# merely waiting on subagents). An event without the field always notifies.
NOTIFY_TYPES="agent_needs_input agent_completed"

# Audio file played when the notification fires. An absolute path, or a path
# relative to this plugin's directory (e.g. alert.wav). Empty = silent.
SOUND_FILE=""
